# Environment overrides (deployment). Never commit real secrets.
# Secrets are provided by Secret Manager at runtime; set the secret NAMES here only.

# Identity / assistant
GOOGLE_CLOUD_PROJECT=your-project
EA_REGION=asia-south1
RESOURCE_PREFIX=ea
OWNER_EMAIL=owner@example.com
ASSISTANT_NAME=my-ea
ASSISTANT_TIMEZONE=Asia/Kolkata
RECAP_HOURS=9,12,15,18,21

# Buckets
STATE_BUCKET=your-project-ea-state
CHAT_STATE_BUCKET=your-project-ea-chat-state

# Model (DeepSeek)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=8000
DEEPSEEK_RETRY_MAX_TOKENS=16000
DEEPSEEK_TIMEOUT=150
CONTEXT_MAX_CHARS=70000

# Secret references (names, not values)
DEEPSEEK_API_KEY=ea-deepseek-api-key
OPENAI_API_KEY=ea-openai-api-key
CHAT_USER_JSON=ea-chat-oauth
GMAIL_USER_JSON=ea-gmail-oauth
TASKS_USER_JSON=ea-tasks-oauth

# Health flag
VALIDATION_ONLY=0
